[core]
	pager = less -FRSX
	editor = code -r -w
	autocrlf = input
	; ~/ rather than an absolute path: git expands it, so global excludes work
	; whatever the account is called.
	excludesfile = ~/.gitignore_global

[user]
	email = jcouball@yahoo.com
	name = James Couball

[init]
	defaultBranch = main

[diff]
	tool = vscode

[difftool "vscode"]
	cmd = code --wait --diff $LOCAL $REMOTE

[difftool]
	prompt = false
[alias]
	lg = log -n 10 --oneline --graph --decorate
	nuke = !git reset --hard && git clean -fdx
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
