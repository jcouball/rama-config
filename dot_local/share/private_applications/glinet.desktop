[Desktop Entry]
Type=Application
Name=GL·iNET
Comment=GL.iNet KVM remote access
Exec=google-chrome "--app=https://www.glkvm.com/#/login"
Icon=glinet
Categories=Network;
# Chrome gives an --app window this class, built from the URL's host and path
# and the profile directory. It ties the window to this launcher, so the dock
# does not show a second icon for it.
StartupWMClass=chrome-www.glkvm.com__-Default
