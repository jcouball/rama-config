# Source files that must never be deployed to the home directory.
#
# Anything in the source root without a leading dot becomes a target: without
# these lines chezmoi would write ~/README.md, ~/LICENSE.txt,
# ~/apt-packages.txt and a whole ~/certification directory. Dot-prefixed
# source entries (.gitattributes, .chezmoiscripts, .chezmoi.toml.tmpl) are
# ignored by chezmoi automatically.

apt-packages.txt
dock-favorites.txt
dock-settings.txt
snap-packages.txt
sshd-rama.conf
ufw-rules.txt
vscode-extensions.txt
certification
